<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 版本号唯一来源：发布时只改这里，显示约定为 V<Version>（见 Services/AppInfo.cs） -->
    <Version>0.1.2</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 许可与版权信息，写入程序集特性（exe 右键「属性 - 详细信息」可见） -->
    <Copyright>Copyright 2026 logcat viewer contributors. Licensed under the Apache License, Version 2.0.</Copyright>
  </PropertyGroup>

  <!-- 构建 / 发布产物中携带项目文档（README、许可、第三方声明与免责声明），满足 Apache-2.0 第 4 条的分发要求 -->
  <ItemGroup>
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="README.zh-CN.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="DISCLAIMER.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    发布为【自包含】：目标机不需要预装 .NET Desktop Runtime。
    起因：原发布是框架依赖（runtimeconfig 声明依赖 Microsoft.NETCore.App /
    Microsoft.WindowsDesktop.App 10.0.0，目录内无 coreclr.dll），但 README
    写着"运行已发布版本不需要 SDK"，下载即用的前提不成立——没装运行时的机器
    双击即报错。

    代价是包体积 1.8 MB → 约 120 MB（压缩后约 45 MB）。这是"下载即用"的
    必要成本：目标用户是 Android 开发者，装 .NET Desktop Runtime 是额外门槛。

    为什么不用 PublishSingleFile：实测单文件 exe 在本机无法启动
    （Failed to map file... error 5 / bundle memory map 失败，非沙箱复测同样失败）。
    故保持多文件形态 —— 目录里 coreclr.dll / hostfxr.dll / hostpolicy.dll
    齐全，是真自包含。

    DebugType/DebugSymbols 去掉 pdb：发布体积的头号隐形杀手，且本项目
    无需给用户分发符号。真正跑不通时再临时加回来。
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AdvancedSharpAdbClient" Version="3.6.16" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
  </ItemGroup>

  <!-- 单元测试工程位于 tests/ 子目录：默认 glob 会把它当作本工程的源码，必须排除 -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <Content Remove="tests/**" />
  </ItemGroup>

  <!-- 仅向测试程序集开放 internal 成员（用于构造不落盘的存储实例），不改变运行时可见性 -->
  <ItemGroup>
    <InternalsVisibleTo Include="logcat.Tests" />
  </ItemGroup>

</Project>