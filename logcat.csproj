<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 零拷贝正文读取（LogDocument.MessageSession）经 SafeMemoryMappedViewHandle.AcquirePointer
         取裸指针，需要 unsafe 上下文；该开关是工程级的，unsafe 代码集中收敛在 LogDocument.cs
         的会话类内，不散落到其他文件 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 版本号唯一来源：发布时只改这里，显示约定为 V<Version>（见 Services/AppInfo.cs） -->
    <Version>0.1.6</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 许可与版权信息，写入程序集特性（exe 右键「属性 - 详细信息」可见） -->
    <Copyright>Copyright 2026 logcat viewer contributors. Licensed under the Apache License, Version 2.0.</Copyright>
  </PropertyGroup>

  <!-- 构建 / 发布产物中携带项目文档（README、许可、第三方声明与免责声明），满足 Apache-2.0 第 4 条的分发要求 -->
  <ItemGroup>
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="README.zh-CN.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="DISCLAIMER.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 文件代理示例（sample/fileproxy/）：随发布包分发，用户解压后按其中 README 即可配置代理 -->
    <None Include="sample/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- README 中的演示动图：按仓库内相对路径 docs/images/ 分发，保证解压后 README 图片链接可解析 -->
    <None Include="docs/images/main.gif" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    发布形态：每个版本发两个包 —— 自包含 + 框架依赖。

    ⚠️ **SelfContained 绝不能无条件写在这里。**
    它会沿 ProjectReference 传染：测试工程（框架依赖）会报
    NETSDK1151「自包含的可执行文件不能由非自包含的可执行文件引用」，
    直接打断 CI。所以这里只声明"默认关闭"（即框架依赖），
    由发布命令用 -p:SelfContained=true 打开。

    两种形态的取舍：
    - 自包含（约 120 MB）：目标机只需 Windows，双击即用，面向大多数用户
    - 框架依赖（约 2 MB）：目标机须预装 .NET 10 Desktop Runtime，
      面向已装运行时的机器 / 内网分发 / 带宽敏感场景
    注意：装运行时必须是 Desktop Runtime，只装 .NET Runtime 或
    ASP.NET Core Runtime 都起不来。

    为什么不用 PublishSingleFile：实测单文件 exe 无法启动
    （Failed to map file... error 5 / bundle memory map 失败，非沙箱复测同样失败）。
  -->
  <PropertyGroup>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <!--
      发布产物不打包 pdb（瘦身），但必须按 Configuration 条件化：
      无条件 none 会连 Debug 构建也不产 pdb，coverlet 拒绝对 logcat.dll 插桩，
      整条覆盖率链路静默产出空报告（2026-10-10 引入、10-11 排查）。
      dotnet test / 覆盖率采集都在 Debug 下进行，Debug 保留默认 portable。
    -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AdvancedSharpAdbClient" Version="3.6.16" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
  </ItemGroup>

  <!-- 单元测试工程位于 tests/ 子目录：默认 glob 会把它当作本工程的源码，必须排除 -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <Content Remove="tests/**" />
  </ItemGroup>

  <!-- 仅向测试程序集开放 internal 成员（用于构造不落盘的存储实例），不改变运行时可见性 -->
  <ItemGroup>
    <InternalsVisibleTo Include="logcat.Tests" />
  </ItemGroup>

</Project>